{
  "name": "@wyrd-company/t3code-mcp",
  "version": "0.0.0",
  "description": "Stdio MCP tools for dispatching and communicating across T3 Code servers.",
  "keywords": [
    "agents",
    "mcp",
    "stdio",
    "t3code"
  ],
  "homepage": "https://github.com/wyrd-company/t3code-client#readme",
  "bugs": {
    "url": "https://github.com/wyrd-company/t3code-client/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyrd-company/t3code-client.git",
    "directory": "packages/t3code-mcp"
  },
  "bin": {
    "t3code-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "test:live": "vp test run --config vitest.live.config.ts",
    "prepack": "pnpm build",
    "package": "../../scripts/release/verify-consumer.sh \"$(../../scripts/release/verify-package.sh t3code-mcp)\" t3code-mcp \"$(../../scripts/release/verify-package.sh t3code-lib)\"",
    "test:protocol": "vp test run --config vitest.protocol.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@wyrd-company/t3code-lib": "workspace:*",
    "uuid": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.12.4",
    "ajv": "^8.17.1",
    "t3": "0.1.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=22.16"
  }
}
