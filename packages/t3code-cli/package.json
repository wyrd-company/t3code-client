{
  "name": "@wyrd-company/t3code-cli",
  "version": "0.1.0",
  "description": "Node command-line client for stock T3 Code.",
  "homepage": "https://github.com/wyrd-company/t3code-client/tree/main/packages/t3code-cli#readme",
  "bugs": {
    "url": "https://github.com/wyrd-company/t3code-client/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyrd-company/t3code-client.git",
    "directory": "packages/t3code-cli"
  },
  "bin": {
    "t3c": "dist/cli.js"
  },
  "files": [
    "dist",
    "commandSurface.json",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:live": "vp test run --config vitest.live.config.ts",
    "prepack": "pnpm build && node scripts/shrinkwrap.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@wyrd-company/t3code-lib": "workspace:*",
    "commander": "^15.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
