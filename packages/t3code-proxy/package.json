{
  "name": "@wyrd-company/t3code-proxy",
  "version": "0.0.0",
  "description": "Service that shows who sent each message on a shared T3 Code server.",
  "keywords": [
    "proxy",
    "t3code"
  ],
  "homepage": "https://github.com/wyrd-company/t3code-client/tree/main/packages/t3code-proxy#readme",
  "bugs": {
    "url": "https://github.com/wyrd-company/t3code-client/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyrd-company/t3code-client.git",
    "directory": "packages/t3code-proxy"
  },
  "bin": {
    "t3c-proxy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:live": "vp test run --config vitest.live.config.ts",
    "test:proof": "vp test run --config vitest.proof.config.ts",
    "prepack": "pnpm build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "httpxy": "^0.5.6",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@wyrd-company/t3code-lib": "workspace:*"
  },
  "engines": {
    "node": ">=22.16"
  }
}
