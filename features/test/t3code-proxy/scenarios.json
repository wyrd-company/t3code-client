{
  "custom-options": {
    "image": "t3code-proxy-feature-test:noble",
    "remoteUser": "root",
    "features": {
      "t3code-proxy": {
        "configPath": "/opt/sample/proxy.yml",
        "serviceUser": "root"
      }
    }
  },
  "caddy-hostname": {
    "image": "t3code-proxy-feature-test:noble",
    "remoteUser": "root",
    "features": {
      "ghcr.io/wyrd-company/devcontainers/caddy:1": {},
      "ghcr.io/wyrd-company/devcontainers/t3code-server:2": {
        "version": "0.1.7",
        "dnsName": "t3.dev.example.test"
      },
      "t3code-proxy": {
        "serviceUser": "vscode"
      }
    }
  },
  "caddy-no-hostname": {
    "image": "t3code-proxy-feature-test:noble",
    "remoteUser": "root",
    "features": {
      "ghcr.io/wyrd-company/devcontainers/caddy:1": {},
      "ghcr.io/wyrd-company/devcontainers/t3code-server:2": {
        "version": "0.1.7"
      },
      "t3code-proxy": {}
    }
  }
}
