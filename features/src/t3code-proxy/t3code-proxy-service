#!/usr/bin/env bash
# Starts t3c-proxy as the service user. A missing or invalid config file stops
# here with the error from t3c-proxy, and s6 runs the service again.

set -euo pipefail

lib_dir=/usr/local/lib/t3code-proxy
# shellcheck disable=SC1091
source "${lib_dir}/config.env"

export HOME="${T3CODE_PROXY_HOME}"
export USER="${T3CODE_PROXY_USER}"
export LOGNAME="${T3CODE_PROXY_USER}"
export PATH="${T3CODE_PROXY_NODE_DIR}:${PATH}"

users="$(/usr/local/bin/t3c-proxy --config "${T3CODE_PROXY_CONFIG}" --list-users)"
"${lib_dir}/write-caddy-sites" <<<"${users}"

exec /usr/local/bin/t3c-proxy --config "${T3CODE_PROXY_CONFIG}"
