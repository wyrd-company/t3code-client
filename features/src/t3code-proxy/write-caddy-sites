#!/usr/bin/env bash
# Writes one Caddy site for each person. Stdin has the output of
# `t3c-proxy --list-users`: the port, a tab and the name on each line.
#
# It writes nothing unless the t3code-server service exists and its host file
# names the server's DNS name. Each person's hostname is the server's hostname
# with `-<name in lowercase>` added to the first label.

set -euo pipefail

service_definition="${1:-/etc/s6-overlay/s6-rc.d/t3code-server}"
caddy_root="${2:-/etc/caddy}"

server_host_file="${caddy_root}/required-hosts.d/t3code-server.host"
sites_file="${caddy_root}/conf.d/t3code-proxy.caddy"
hosts_file="${caddy_root}/required-hosts.d/t3code-proxy.host"

fail() {
    echo "[t3code-proxy] ERROR: $*" >&2
    exit 1
}

[ -e "${service_definition}" ] || exit 0
[ -f "${server_host_file}" ] || exit 0
server=""
IFS= read -r server <"${server_host_file}" || true
[ -n "${server}" ] || exit 0

first_label="${server%%.*}"
parent="${server#*.}"
[ "${parent}" != "${server}" ] || fail "The server hostname '${server}' has no parent domain."

sites=""
hosts=""
declare -A seen=()
while IFS=$'\t' read -r port name; do
    [ -n "${port}" ] || continue
    label="${first_label}-$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<<"${name}")"
    [[ "${label}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] \
        || fail "The name '${name}' does not make a valid DNS label."
    host="${label}.${parent}"
    [ "${#host}" -le 253 ] || fail "The hostname for '${name}' exceeds the 253-character DNS limit."
    [ -z "${seen[${label}]:-}" ] \
        || fail "The names '${seen[${label}]}' and '${name}' make the same DNS label."
    seen[${label}]="${name}"
    sites+="${host} {"$'\n'"    reverse_proxy 127.0.0.1:${port}"$'\n'"}"$'\n'
    hosts+="${host}"$'\n'
done

temporary=()
cleanup() {
    [ "${#temporary[@]}" -eq 0 ] || rm -f "${temporary[@]}"
}
trap cleanup EXIT

# A temporary name matches neither `*.caddy` nor `*.host`. The hosts come first,
# so that the Caddy watcher waits for every name that a new site needs.
replace() {
    local target="$1" content="$2" staged
    staged="$(mktemp "$(dirname "${target}")/.t3code-proxy.XXXXXX")"
    temporary+=("${staged}")
    printf '%s' "${content}" >"${staged}"
    chmod 0644 "${staged}"
    mv -f "${staged}" "${target}"
}
replace "${hosts_file}" "${hosts}"
replace "${sites_file}" "${sites}"
