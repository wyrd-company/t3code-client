{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI semantic sections",
  "description": "Ordered normative CLI behavior sections projected into public usage guides. The command-line specification owns these assets.",
  "type": "object",
  "required": ["title", "relationships", "sections"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "relationships": {
      "type": "object"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
